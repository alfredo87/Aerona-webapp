# Home Assistant URL. Keep the token private and do not put it in public/index.html.
# Example: http://homeassistant.local:8123
HA_URL=http://homeassistant.local:8123
HA_TOKEN=replace_with_a_home_assistant_long_lived_access_token

# Browser login for this LAN-only app. Choose a new, strong password.
APP_USERNAME=fred
APP_PASSWORD=replace_with_a_strong_unique_password

# Generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_a_random_64_character_secret

# Port exposed by compose.yaml.
PORT=8787
