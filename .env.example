# Home Assistant URL. Keep the token private and do not put it in public/index.html.
# Example: http://homeassistant.local:8123
HA_URL=http://homeassistant.local:8123
HA_TOKEN=replace_with_a_home_assistant_long_lived_access_token

# Browser login for this LAN-only app. Choose a new, strong password.
APP_USERNAME=fred
APP_PASSWORD=replace_with_a_strong_unique_password

# Generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_a_random_64_character_secret

# The container always listens on 8787. These control the host-side binding.
# For a direct trusted-LAN deployment, keep the defaults.
# For YunoHost HTTPS reverse-proxy deployment, use BIND_ADDRESS=127.0.0.1.
BIND_ADDRESS=0.0.0.0
HOST_PORT=8787

# Set true only when the public site is served through HTTPS, for example by YunoHost.
COOKIE_SECURE=false

# Internal app port.
PORT=8787
