# Put this in the YunoHost domain's Nginx configuration after creating an
# aerona subdomain in the YunoHost admin interface. Adjust the domain name
# managed by YunoHost; do not expose port 8787 through your router.

location / {
    proxy_pass http://127.0.0.1:8787;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
