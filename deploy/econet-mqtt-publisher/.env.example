# ecoNET controller on the local network
ECONET_ENDPOINT=192.168.178.60
ECONET_USERNAME=admin
ECONET_PASSWORD=replace-with-your-controller-password

# Home Assistant Mosquitto broker
MQTT_HOST=192.168.178.38
MQTT_PORT=1883
MQTT_USERNAME=econet_mqtt
MQTT_PASSWORD=replace-with-your-mqtt-password

MQTT_TOPIC_PREFIX=econet/
POLLING_INTERVAL=30
HA_DISCOVERY_MESSAGES=true
HA_DISCOVERY_NAME=Grant Aerona ecoNET
